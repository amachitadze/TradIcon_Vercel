# ========================================================
# Tradicon [Ka, Es] — გარემოს ცვლადების კონფიგურაცია
# ========================================================

# 1. Google Gemini API გასაღები (ძირითადი პროვაიდერი)
# მიიღეთ Google AI Studio-დან: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq API გასაღები (არასავალდებულო, მაგრამ რეკომენდებული ალტერნატივა)
# იძლევა ულტრა-სწრაფ უფასო Llama 3.3 70B ინფერენსს. გამოიყენება ფოლბექად, თუ Gemini გადაიტვირთება (503).
# მიიღეთ უფასოდ Groq Console-დან: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter API გასაღები (არასავალდებულო ალტერნატივა)
# უზრუნველყოფს უფასო ღია მოდელებზე წვდომას. გამოიყენება დამატებით რეზერვად.
# მიიღეთ OpenRouter-იდან: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
